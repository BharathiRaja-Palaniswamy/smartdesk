# Copy to .env and fill in.
# Claude's key, for the "claude" model set and the eval judge.
ANTHROPIC_API_KEY=

# Which models the app uses: "claude" or "opensource" (models hosted by
# Nebius). Each set has a high-end model (the chats, the Front Desk agent) and a
# low-end one (quick jobs, like reading a name and number). See
# smartdesk/models/profiles.py. The evals always use "opensource".
SMARTDESK_MODELS=claude

# Tracing with LangSmith (optional): records each assistant question so it can
# be inspected at smith.langchain.com. Leave LANGSMITH_TRACING out to keep it off.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=smartdesk
# Eval runs (python -m evals.run) are traced to their own project, not the one above.
# LANGSMITH_EVAL_PROJECT=smartdesk-evals
# The business's time zone, used to tell the assistant the current time.
# SMARTDESK_TIMEZONE=America/Los_Angeles
# The business's own files. SmartDesk holds no business's data, so these have
# no default: point them at the business you run (until onboarding stores
# businesses in their own cells).
# The business document the assistants answer from (markdown):
# SMARTDESK_DATA=
# Its bookings, for the reports (JSON):
# SMARTDESK_REPORT_DATA=
# Its golden eval set, for evals/ (JSON):
# SMARTDESK_EVAL_SET=
# The name the customer chat's assistant gives itself (optional):
# SMARTDESK_ASSISTANT_NAME=
# Search: the document is cut into chunks of this many tokens, each sharing this
# many tokens with the chunk before it.
# SMARTDESK_CHUNK_TOKENS=150
# SMARTDESK_CHUNK_OVERLAP=30
# Search: the most tokens of the header written above each chunk for search only
# (its place in the document, e.g. "Core Services > Facials > Express
# Facial"); 0 for no headers. Chunk size + header must fit the embedding model.
# SMARTDESK_HEADER_TOKENS=50
# Search: text is turned into vectors by llama-text-embed-v2 on Pinecone's
# servers, with PINECONE_API_KEY below. Which vector store keeps the chunks:
# "pinecone" (the default) is hosted and needs the key; its index is created
# on first use. "memory" keeps them in the app's memory, for the tests.
# SMARTDESK_VECTOR_STORE=pinecone
# PINECONE_API_KEY=
# SMARTDESK_PINECONE_INDEX=smartdesk
# Search: how many chunks are given to the model for a question.
# SMARTDESK_RETRIEVAL_TOP_K=3
# Search: the reranker that reorders the first search's candidates before the
# best SMARTDESK_RETRIEVAL_TOP_K are kept: "pinecone" (the default,
# bge-reranker-v2-m3 on Pinecone's servers) or "none" to keep the first
# search's order; and how many candidates it chooses from.
# SMARTDESK_RERANKER=pinecone
# SMARTDESK_RERANK_CANDIDATES=20
# Booking: bookings are kept on the staff members' Google calendars, always (see
# docs/guides/google-calendar.md); without GOOGLE_SERVICE_ACCOUNT below, booking says
# it is unavailable. And the grid appointments start on (every 30 minutes from opening).
# SMARTDESK_SLOT_MINUTES=30
# The fewest minutes ahead a customer can book, change or cancel an appointment.
# SMARTDESK_MIN_NOTICE_MINUTES=30
# The owner's sign-in for the manage page (smartdesk/access/). Without a
# password the manage page and the reports stay closed to everyone.
# SMARTDESK_OWNER_PASSWORD=
# Signs the sign-in cookie; without it, a random key is made at each start
# (which signs the owner out on every restart).
# SMARTDESK_SESSION_SECRET=
# The phone line (smartdesk/voice/): the secret ElevenLabs sends as its API key
# when it calls POST /v1/chat/completions. Leave it out to keep the line off.
# SMARTDESK_VOICE_SECRET=
# The ElevenLabs agent the manage page's phone-line test (a voice widget)
# talks to: its agent id, not a secret. Leave it out to hide the widget.
# Customers never see it. The agent must allow public use, limited to the
# site's addresses in its Security > Allowlist.
# SMARTDESK_VOICE_AGENT_ID=
# Where the chat writes down customers it hands to the staff, with why.
# SMARTDESK_HANDOFFS=storage/handoffs.jsonl
# Where the Feedback agent writes down what customers say about their visits.
# SMARTDESK_FEEDBACK=storage/feedback.jsonl
# Debug mode, for testing: under each of the Front Desk agent's replies, show
# what happened between the agents. Anyone using the chat sees it, so keep it
# off on a site customers use.
# SMARTDESK_DEBUG=false
# The service account's key file (its path, or its JSON text on a host); and,
# optionally, a Google account to share the calendars with, so someone can
# see the bookings in Google Calendar.
# GOOGLE_SERVICE_ACCOUNT=
# SMARTDESK_CALENDAR_OWNER=
# The model gateway (smartdesk/models/): the models in each set. A model is
# "provider:model"; providers are "anthropic" (Claude) and "nebius" (open
# models). The eval judge always stays on Claude Opus.
# SMARTDESK_CLAUDE_HIGH=anthropic:claude-opus-5-5
# SMARTDESK_CLAUDE_LOW=anthropic:claude-haiku-4-5-20251001
# SMARTDESK_OPENSOURCE_HIGH=nebius:Qwen/Qwen3-235B-A22B-Instruct-2507
# SMARTDESK_OPENSOURCE_LOW=nebius:Qwen/Qwen3-30B-A3B-Instruct-2507
# A second model to try when the first fails (or answers in the wrong shape); off by default:
# SMARTDESK_MODEL_FALLBACK=
# Move one job to another model, e.g. SMARTDESK_PROFILE_CHEAP_ROUTER=nebius:<model>
# Nebius: its OpenAI-compatible address (check it in the Nebius console) and key.
# SMARTDESK_NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
# NEBIUS_API_KEY=
